# Max accepted HTML payload size in bytes (default 10 MB)
SEO_MAX_HTML_BYTES=10485760
# Title length thresholds (characters)
SEO_TITLE_MIN=30
SEO_TITLE_MAX=60
# Meta description thresholds (characters)
SEO_META_DESC_MIN=70
SEO_META_DESC_MAX=160
# Content thresholds (approximate words)
SEO_VERY_THIN_WORDS=100
SEO_THIN_WORDS=300
